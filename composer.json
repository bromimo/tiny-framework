{
    "name": "proj1/users-api",
    "description": "Simple REST API for managing users",
    "type": "project",
    "require": {
        "php": "^8.2",
        "bromimo/tiny-router": "^1.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/uuid.php",
            "app/Helpers/auth.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
